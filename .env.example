# Conexión con el CMS Codeplex.
#
# Sin CMS_URL el sitio compila con los JSON de src/idiomas/ exactamente como
# antes de la integración. Eso es deliberado: una caída del panel no puede
# impedir un despliegue, y quien trabaje en el diseño no necesita levantar el
# backend para ver la web.

# URL base de la API. La lee la compilación, no el navegador.
CMS_URL=https://cms.codeplex.pe

# Código del sitio en el CMS. En mayúsculas, como exige la tabla `sitio`.
CMS_SITIO=AIROBOTICS

# Segundos antes de rendirse y compilar con el contenido local.
CMS_ESPERA_SEGUNDOS=15

# URL del CMS tal como la alcanza el navegador del visitante, para los
# formularios de contacto y boletín. Solo hace falta si difiere de CMS_URL
# (por ejemplo, si la compilación usa una red interna). Se hornea en el HTML.
PUBLIC_CMS_URL=

# Anulación manual del endpoint de contacto. Si se define, tiene prioridad
# sobre el del CMS; sirve para apuntar a otro servicio (Formspree y demás).
# Vacío y sin CMS_URL, el formulario vuelve a abrir el cliente de correo.
PUBLIC_ENDPOINT_CONTACTO=
