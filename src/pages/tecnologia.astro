---
import PlantillaBase from '../plantillas/PlantillaBase.astro';
import PortadaSeccion from '../componentes/secciones/PortadaSeccion.astro';
import BarraFiltros from '../componentes/secciones/BarraFiltros.astro';
import PanoramaArquitectura from '../componentes/secciones/tecnologia/PanoramaArquitectura.astro';
import ComponentesTecnologia from '../componentes/secciones/tecnologia/ComponentesTecnologia.astro';
import BandaLlamada from '../componentes/secciones/BandaLlamada.astro';
import { contenido } from '../nucleo/idiomas';

const idioma = 'es' as const;
const metadatos = contenido(idioma, 'tecnologia/metadatos');
const pestanas = contenido(idioma, 'tecnologia/pestanas');
---

<PlantillaBase
  idioma={idioma}
  seccion="tecnologia"
  titulo={metadatos.titulo}
  descripcion={metadatos.descripcion}
  palabrasClave={metadatos.palabrasClave}
  imagenPrincipal="/images/hero-city-night.webp"
>
  <PortadaSeccion
    idioma={idioma}
    alturaMinima={502}
    paquete="tecnologia"
    imagen="/images/hero-city-night.webp"
    posicionImagen="50% 50%"
    altura="alta"
  >
    <img
      slot="escenario"
      class="portada-unidades"
      src="/images/cerberus-unidades.webp"
      alt=""
      width="1402"
      height="882"
      fetchpriority="high"
      decoding="async"
    />
  </PortadaSeccion>
  <BarraFiltros rotulo={pestanas.rotulo} elementos={pestanas.elementos} />
  <PanoramaArquitectura idioma={idioma} />
  <ComponentesTecnologia idioma={idioma} />
  <BandaLlamada
    idioma={idioma}
    paquete="tecnologia"
    imagen="/images/mountains-city-dusk.webp"
    posicionImagen="50% 44%"
    disposicion="cifras"
  />
</PlantillaBase>
