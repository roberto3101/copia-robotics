---
import Icono from './Icono.astro';
import estilos from './BotonVideo.module.css';

interface Props {
  etiqueta: string;
  detalle?: string;
  origen?: string;
  poster?: string;
  clase?: string;
}

const { etiqueta, detalle, origen, poster, clase } = Astro.props;
const Etiqueta = 'button';
const atributos = {
  type: 'button',
  'data-video': origen,
  'data-video-titulo': etiqueta,
  'data-video-poster': poster,
};
---

<Etiqueta class={[estilos.boton, clase].filter(Boolean).join(' ')} {...atributos} aria-label={etiqueta}>
  <span class={estilos.disco}><Icono nombre="reproducir" tamano={17} grosor={1} /></span>
  <span class={estilos.leyenda}>
    <span>{etiqueta}</span>
    {detalle && <span class={estilos.detalle}>{detalle}</span>}
  </span>
</Etiqueta>
