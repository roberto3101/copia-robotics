---
import Contenedor from '../../base/Contenedor.astro';
import Icono from '../../base/Icono.astro';
import Boton from '../../base/Boton.astro';
import EncabezadoSeccion from '../EncabezadoSeccion.astro';
import estilos from './SolucionesResumen.module.css';
import { contenido, type Idioma } from '../../../nucleo/idiomas';
import { ruta } from '../../../nucleo/rutas';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const soluciones = contenido(idioma, 'inicio/soluciones');
const acciones = contenido(idioma, 'comunes/acciones');
const destino = ruta('soluciones', idioma);
---

<section data-bloque="inicio/soluciones" class={estilos.seccion}>
  <Contenedor>
    <EncabezadoSeccion titulo={soluciones.titulo} subtitulo={soluciones.subtitulo} />
    <ul class={estilos.rejilla}>
      {
        soluciones.elementos.map(
          (
            elemento: { icono: string; familia: string; producto: string; descripcion: string },
            indice: number
          ) => (
            <li>
              <a
                class={[estilos.tarjeta, indice === 0 ? estilos.activa : null].filter(Boolean).join(' ')}
                href={destino}
              >
                <Icono nombre={elemento.icono} tamano={40} grosor={1.15} clase={estilos.icono} />
                <h3 class={estilos.nombre}>
                  <span>{elemento.familia}</span>
                  <span>{elemento.producto}</span>
                </h3>
                <p class={estilos.descripcion}>{elemento.descripcion}</p>
                <span class={estilos.enlace}>
                  {acciones.verMas}
                  <Icono nombre="flechaDerecha" tamano={14} grosor={1.6} />
                </span>
              </a>
            </li>
          )
        )
      }
    </ul>
  </Contenedor>
</section>
