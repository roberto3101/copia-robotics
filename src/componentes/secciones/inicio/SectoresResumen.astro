---
import Contenedor from '../../base/Contenedor.astro';
import Icono from '../../base/Icono.astro';
import EncabezadoSeccion from '../EncabezadoSeccion.astro';
import estilos from './SectoresResumen.module.css';
import { contenido, type Idioma } from '../../../nucleo/idiomas';
import { ruta } from '../../../nucleo/rutas';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const sectores = contenido(idioma, 'inicio/sectores');
const destino = ruta('sectores', idioma);
---

<section class={estilos.seccion}>
  <Contenedor>
    <EncabezadoSeccion titulo={sectores.titulo} subtitulo={sectores.subtitulo} />
    <ul class={estilos.rejilla}>
      {
        sectores.elementos.map(
          (elemento: { icono: string; imagen: string; nombre: string; descripcion: string }) => (
            <li>
              <a class={estilos.tarjeta} href={destino}>
                <img
                  class={estilos.imagen}
                  src={`/images/${elemento.imagen}.webp`}
                  alt={elemento.nombre}
                  width="900"
                  height="620"
                  loading="lazy"
                  decoding="async"
                />
                <span class={estilos.pie}>
                  <span class={estilos.cabeza}>
                    <Icono nombre={elemento.icono} tamano={24} grosor={1.3} clase={estilos.icono} />
                    <span class={estilos.nombre}>{elemento.nombre}</span>
                  </span>
                  <span class={estilos.descripcion}>{elemento.descripcion}</span>
                </span>
              </a>
            </li>
          )
        )
      }
    </ul>
  </Contenedor>
</section>
