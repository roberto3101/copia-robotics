---
import Contenedor from '../../base/Contenedor.astro';
import Icono from '../../base/Icono.astro';
import EncabezadoSeccion from '../EncabezadoSeccion.astro';
import PanelLateral from './PanelLateral.astro';
import estilos from './BibliotecaRecursos.module.css';
import { contenido, type Idioma } from '../../../nucleo/idiomas';
import { baseArticulos, ruta, rutaArticulo } from '../../../nucleo/rutas';
import { articulos as articulosPublicados } from '../../../nucleo/articulos';
import { urlImagen } from '../../../nucleo/medios';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const articulos = contenido(idioma, 'recursos/articulos');
const videos = contenido(idioma, 'recursos/videos');
const documentos = contenido(idioma, 'recursos/documentos');
const acciones = contenido(idioma, 'comunes/acciones');
const destino = ruta('recursos', idioma);

/*
 * Las tarjetas de artículo salen del CMS. Mientras no haya ninguno publicado
 * se muestran las del JSON, que es lo que había antes: la sección nunca queda
 * vacía y la migración puede hacerse artículo a artículo.
 *
 * La diferencia visible es el enlace: los del CMS llevan a su propia página;
 * los del JSON no tienen una, así que siguen apuntando al índice de recursos.
 */
const publicados = await articulosPublicados(idioma);
// El enlace de los articulos lleva al indice del blog solo cuando hay
// articulos de verdad; si no, apuntaria a una pagina vacia.
const destinoArticulos = publicados.length > 0 ? baseArticulos[idioma] : destino;
const tarjetas =
  publicados.length > 0
    ? publicados.slice(0, 3).map((articulo) => ({
        distintivo: articulo.distintivo,
        imagen: articulo.imagen,
        fecha: articulo.fechaLegible,
        titulo: articulo.titulo,
        texto: articulo.resumen,
        destino: rutaArticulo(articulo.slug, idioma),
      }))
    : articulos.elementos.map(
        (a: {
          distintivo: string;
          imagen: string;
          fecha: string;
          titulo: string;
          texto: string;
        }) => ({
          distintivo: a.distintivo,
          imagen: urlImagen(a.imagen),
          fecha: a.fecha,
          titulo: a.titulo,
          texto: a.texto,
          destino,
        })
      );
---

<section class={estilos.seccion}>
  <Contenedor clase={estilos.rejilla}>
    <div class={estilos.columna}>
      <article class={estilos.bloque} data-bloque="recursos/articulos" data-ambitos={articulos.ambitos.join(' ')}>
        <EncabezadoSeccion
          titulo={articulos.titulo}
          subtitulo={articulos.subtitulo}
          enlace={articulos.verTodos}
          destinoEnlace={destinoArticulos}
        />
        <ul class={estilos.tercios}>
          {
            tarjetas.map(
              (a: {
                distintivo: string;
                imagen: string;
                fecha: string;
                titulo: string;
                texto: string;
                destino: string;
              }) => (
                <li>
                  <article class={estilos.tarjeta}>
                    <div class={estilos.lienzo}>
                      <img
                        class={estilos.imagen}
                        src={a.imagen}
                        alt={a.titulo.split('\n').join(' ')}
                        width="900"
                        height="520"
                        loading="lazy"
                        decoding="async"
                      />
                      {a.distintivo && <span class={estilos.distintivo}>{a.distintivo}</span>}
                    </div>
                    <div class={estilos.cuerpo}>
                      <span class={estilos.fecha}>{a.fecha}</span>
                      <h3 class={estilos.nombre}>{a.titulo}</h3>
                      <p class={estilos.texto}>{a.texto}</p>
                      <a class={estilos.enlace} href={a.destino}>
                        {acciones.leerMas}
                        <span class="solo-lectores">{` ${a.titulo}`}</span>
                        <Icono nombre="flechaDerecha" tamano={14} grosor={1.6} />
                      </a>
                    </div>
                  </article>
                </li>
              )
            )
          }
        </ul>
      </article>

      <article class={estilos.bloque} data-bloque="recursos/videos" data-ambitos={videos.ambitos.join(' ')}>
        <EncabezadoSeccion
          titulo={videos.titulo}
          subtitulo={videos.subtitulo}
          enlace={videos.verTodos}
          destinoEnlace={destino}
        />
        <ul class={estilos.tercios}>
          {
            videos.elementos.map(
              (v: {
                distintivo: string;
                imagen: string;
                duracion: string;
                titulo: string;
                texto: string;
                video: string;
              }) => (
                <li>
                  <article class={estilos.tarjeta}>
                    <div class={estilos.lienzo}>
                      <img
                        class={estilos.imagen}
                        src={urlImagen(v.imagen)}
                        alt={v.titulo}
                        width="900"
                        height="520"
                        loading="lazy"
                        decoding="async"
                      />
                      <span class={estilos.distintivo}>{v.distintivo}</span>
                      <span class={estilos.duracion}>{v.duracion}</span>
                      <button
                        class={estilos.reproducir}
                        type="button"
                        data-video={v.video}
                        data-video-titulo={v.titulo}
                        data-video-poster={urlImagen(v.imagen)}
                        aria-label={v.titulo}
                      >
                        <Icono nombre="reproducir" tamano={19} grosor={1} />
                      </button>
                    </div>
                    <div class={estilos.cuerpo}>
                      <h3 class={estilos.nombre}>{v.titulo}</h3>
                      <p class={estilos.texto}>{v.texto}</p>
                    </div>
                  </article>
                </li>
              )
            )
          }
        </ul>
      </article>

      <article class={estilos.bloque} data-bloque="recursos/documentos" data-ambitos={documentos.ambitos.join(' ')}>
        <EncabezadoSeccion
          titulo={documentos.titulo}
          subtitulo={documentos.subtitulo}
          enlace={documentos.verTodos}
          destinoEnlace={destino}
        />
        <ul class={estilos.tercios}>
          {
            documentos.elementos.map(
              (d: {
                formato: string;
                distintivo: string;
                titulo: string;
                peso: string;
                archivo: string;
              }) => (
                <li>
                  <a class={estilos.documento} href={d.archivo} download>
                    <span class={[estilos.ficha, estilos[d.formato]].join(' ')}>{d.formato.toUpperCase()}</span>
                    <span class={estilos.datos}>
                      <span class={estilos.distintivoDoc}>{d.distintivo}</span>
                      <span class={estilos.nombreDoc}>{d.titulo}</span>
                      <span class={estilos.peso}>{d.peso}</span>
                    </span>
                  </a>
                </li>
              )
            )
          }
        </ul>
      </article>
    </div>

    <PanelLateral idioma={idioma} />
  </Contenedor>
</section>
