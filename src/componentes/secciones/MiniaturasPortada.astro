---
import estilos from './MiniaturasPortada.module.css';
import { urlImagen } from '../../nucleo/medios';

interface Miniatura {
  imagen: string;
  textoAlternativo: string;
}

interface Props {
  elementos: Miniatura[];
}

const { elementos } = Astro.props;
---

<ul class={estilos.miniaturas}>
  {
    elementos.map((elemento) => (
      <li>
        <img
          src={urlImagen(elemento.imagen)}
          alt={elemento.textoAlternativo}
          width="900"
          height="560"
          loading="lazy"
          decoding="async"
        />
      </li>
    ))
  }
</ul>
